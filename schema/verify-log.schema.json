{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://old-wives.local/schema/verify-log.schema.json",
  "title": "Verify log",
  "description": "Every item the verify agent removed, downgraded, re-tagged, re-formed or flagged in one entry, with its reason. `family` is an item too: a family the cited pages do not support is logged in `removed` (field `/family`, text its value), a re-cited one in `retagged`.",
  "type": "object",
  "required": [
    "entry_id",
    "verifier_prompt_version",
    "removed",
    "downgraded",
    "retagged",
    "reformed",
    "flagged",
    "grade",
    "grade_rationale"
  ],
  "properties": {
    "entry_id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "verifier_prompt_version": { "$ref": "#/$defs/NonEmptyString" },
    "removed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "text", "cites", "reason"],
        "properties": {
          "field": { "$ref": "#/$defs/NonEmptyString" },
          "text": { "$ref": "#/$defs/NonEmptyString" },
          "cites": { "$ref": "#/$defs/CiteList" },
          "reason": { "$ref": "#/$defs/NonEmptyString" }
        },
        "unevaluatedProperties": false
      }
    },
    "downgraded": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "text", "to_text", "from_cites", "to_cites", "reason"],
        "properties": {
          "field": { "$ref": "#/$defs/NonEmptyString" },
          "text": { "$ref": "#/$defs/NonEmptyString" },
          "to_text": { "$ref": "#/$defs/NonEmptyString" },
          "from_cites": { "$ref": "#/$defs/CiteList" },
          "to_cites": { "$ref": "#/$defs/CiteList" },
          "reason": { "$ref": "#/$defs/NonEmptyString" }
        },
        "unevaluatedProperties": false
      }
    },
    "retagged": {
      "type": "array",
      "items": { "$ref": "#/$defs/CiteChange" }
    },
    "reformed": {
      "description": "Appearance clauses moved to another form; null is the common set (no form). Like retagged, a reformed clause stays in the entry.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "text", "from_form", "to_form", "reason"],
        "properties": {
          "field": { "$ref": "#/$defs/NonEmptyString" },
          "text": { "$ref": "#/$defs/NonEmptyString" },
          "from_form": { "$ref": "#/$defs/FormRef" },
          "to_form": { "$ref": "#/$defs/FormRef" },
          "reason": { "$ref": "#/$defs/NonEmptyString" }
        },
        "unevaluatedProperties": false
      }
    },
    "flagged": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "text", "reason"],
        "properties": {
          "field": { "$ref": "#/$defs/NonEmptyString" },
          "text": { "$ref": "#/$defs/NonEmptyString" },
          "reason": { "$ref": "#/$defs/NonEmptyString" }
        },
        "unevaluatedProperties": false
      }
    },
    "grade": {
      "enum": ["widely-attested", "regional", "literary", "disputed"]
    },
    "grade_rationale": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["text", "cites"],
        "properties": {
          "text": { "$ref": "#/$defs/NonEmptyString" },
          "cites": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/CiteTag" }
          }
        },
        "unevaluatedProperties": false
      }
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "NonEmptyString": { "type": "string", "minLength": 1 },
    "FormRef": {
      "anyOf": [{ "type": "null" }, { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }]
    },
    "CiteTag": {
      "type": "string",
      "pattern": "^[a-z0-9]+:(p\\.[0-9ivxlcdm]+|pp\\.[0-9ivxlcdm]+-[0-9ivxlcdm]+|s\\.v\\..+)$"
    },
    "CiteList": {
      "type": "array",
      "items": { "$ref": "#/$defs/CiteTag" }
    },
    "CiteChange": {
      "type": "object",
      "required": ["field", "text", "from_cites", "to_cites", "reason"],
      "properties": {
        "field": { "$ref": "#/$defs/NonEmptyString" },
        "text": { "$ref": "#/$defs/NonEmptyString" },
        "from_cites": { "$ref": "#/$defs/CiteList" },
        "to_cites": { "$ref": "#/$defs/CiteList" },
        "reason": { "$ref": "#/$defs/NonEmptyString" }
      },
      "unevaluatedProperties": false
    }
  }
}
