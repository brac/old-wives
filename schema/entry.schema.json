{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beasts.local/schema/entry.schema.json",
  "title": "Bestiary entry",
  "type": "object",
  "required": [
    "id",
    "schema_version",
    "names",
    "peoples_regions",
    "family",
    "appearance_forms",
    "appearance",
    "scene",
    "variants",
    "behavior_habitat",
    "dealing_with_it",
    "origin",
    "related",
    "attestation",
    "sources",
    "image",
    "notes"
  ],
  "properties": {
    "id": { "$ref": "#/$defs/KebabId" },
    "schema_version": { "const": 2 },
    "names": {
      "type": "object",
      "required": ["primary", "variants", "meaning"],
      "properties": {
        "primary": {
          "type": "object",
          "required": ["romanized", "native"],
          "properties": {
            "romanized": { "$ref": "#/$defs/NonEmptyString" },
            "native": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/NativeName" }
            }
          },
          "unevaluatedProperties": false
        },
        "variants": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["romanized", "peoples", "cites"],
            "properties": {
              "romanized": { "$ref": "#/$defs/NonEmptyString" },
              "native": {
                "type": "array",
                "items": { "$ref": "#/$defs/NativeName" }
              },
              "peoples": { "$ref": "#/$defs/Peoples" },
              "cites": { "$ref": "#/$defs/Cites" }
            },
            "unevaluatedProperties": false
          }
        },
        "meaning": { "$ref": "#/$defs/Clauses" }
      },
      "unevaluatedProperties": false
    },
    "peoples_regions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["people", "cites"],
        "properties": {
          "people": { "$ref": "#/$defs/People" },
          "region": { "$ref": "#/$defs/NonEmptyString" },
          "cites": { "$ref": "#/$defs/Cites" }
        },
        "unevaluatedProperties": false
      }
    },
    "family": {
      "description": "A family the cited pages support, or `unclassified` with no cites (rule R-FAMILY).",
      "type": "object",
      "required": ["value", "cites"],
      "properties": {
        "value": {
          "enum": [
            "household",
            "water",
            "forest",
            "field",
            "undead",
            "disease-and-fate",
            "monster",
            "other",
            "unclassified"
          ]
        },
        "cites": {
          "type": "array",
          "items": { "$ref": "#/$defs/CiteTag" }
        }
      },
      "unevaluatedProperties": false
    },
    "appearance_forms": {
      "description": "Forms for appearance clauses that conflict across sources. A clause without `form` describes every form; clauses sharing a `form` make one figure (rules R-FORM-*).",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "$ref": "#/$defs/KebabId" },
          "label": { "$ref": "#/$defs/NonEmptyString" }
        },
        "unevaluatedProperties": false
      }
    },
    "appearance": {
      "type": "array",
      "items": { "$ref": "#/$defs/AppearanceClause" }
    },
    "scene": { "$ref": "#/$defs/Clauses" },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "peoples", "appearance", "behavior_habitat"],
        "properties": {
          "id": { "$ref": "#/$defs/KebabId" },
          "label": { "$ref": "#/$defs/NonEmptyString" },
          "peoples": { "$ref": "#/$defs/Peoples" },
          "appearance": { "$ref": "#/$defs/Clauses" },
          "behavior_habitat": { "$ref": "#/$defs/Clauses" },
          "notes": { "type": "string" }
        },
        "unevaluatedProperties": false
      }
    },
    "behavior_habitat": { "$ref": "#/$defs/Clauses" },
    "dealing_with_it": { "$ref": "#/$defs/Clauses" },
    "origin": { "$ref": "#/$defs/Clauses" },
    "related": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "relation"],
        "properties": {
          "id": { "$ref": "#/$defs/KebabId" },
          "relation": {
            "enum": ["often-confused", "related", "class-of", "instance-of"]
          }
        },
        "unevaluatedProperties": false
      }
    },
    "attestation": {
      "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/Attestation" }]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "author", "title", "year", "url", "public_domain"],
        "properties": {
          "source_id": { "$ref": "#/$defs/SourceId" },
          "author": { "$ref": "#/$defs/NonEmptyString" },
          "title": { "$ref": "#/$defs/NonEmptyString" },
          "year": { "type": "integer" },
          "url": { "type": "string", "format": "uri" },
          "public_domain": { "type": "boolean" }
        },
        "unevaluatedProperties": false
      }
    },
    "image": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": [
            "file",
            "thumb",
            "prompt",
            "model",
            "seed",
            "date",
            "style_tokens_version",
            "licence",
            "interpretive",
            "cost_usd",
            "human_edits"
          ],
          "properties": {
            "file": { "$ref": "#/$defs/NonEmptyString" },
            "thumb": { "$ref": "#/$defs/NonEmptyString" },
            "prompt": { "$ref": "#/$defs/NonEmptyString" },
            "negative": { "type": "string" },
            "model": { "$ref": "#/$defs/NonEmptyString" },
            "seed": { "type": "integer" },
            "date": { "type": "string", "format": "date" },
            "style_tokens_version": { "$ref": "#/$defs/NonEmptyString" },
            "licence": { "type": "string" },
            "interpretive": { "type": "boolean" },
            "cost_usd": { "type": "number" },
            "request_id": { "type": "string" },
            "human_edits": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["type", "text", "by", "date"],
                "properties": {
                  "type": { "$ref": "#/$defs/NonEmptyString" },
                  "text": { "$ref": "#/$defs/NonEmptyString" },
                  "by": { "$ref": "#/$defs/NonEmptyString" },
                  "date": { "type": "string", "minLength": 1, "format": "date" }
                },
                "unevaluatedProperties": false
              }
            }
          },
          "unevaluatedProperties": false
        }
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "text"],
        "properties": {
          "kind": {
            "enum": ["accretion", "disputed", "scope", "empty-field", "other"]
          },
          "text": { "$ref": "#/$defs/NonEmptyString" },
          "cites": {
            "type": "array",
            "items": { "$ref": "#/$defs/CiteTag" }
          }
        },
        "unevaluatedProperties": false
      }
    }
  },
  "if": {
    "type": "object",
    "required": ["appearance"],
    "properties": { "appearance": { "type": "array", "maxItems": 0 } }
  },
  "then": {
    "type": "object",
    "properties": { "scene": { "type": "array", "minItems": 1 } }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "NonEmptyString": { "type": "string", "minLength": 1 },
    "KebabId": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "SourceId": { "type": "string", "pattern": "^[a-z0-9]+$" },
    "CiteTag": {
      "type": "string",
      "pattern": "^[a-z0-9]+:(p\\.[0-9ivxlcdm]+|pp\\.[0-9ivxlcdm]+-[0-9ivxlcdm]+|s\\.v\\..+)$"
    },
    "Cites": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/CiteTag" }
    },
    "Clause": {
      "type": "object",
      "required": ["text", "cites"],
      "properties": {
        "text": { "$ref": "#/$defs/NonEmptyString" },
        "cites": { "$ref": "#/$defs/Cites" }
      },
      "unevaluatedProperties": false
    },
    "Clauses": {
      "type": "array",
      "items": { "$ref": "#/$defs/Clause" }
    },
    "AppearanceClause": {
      "description": "A top-level appearance clause, with an optional `form`: the id of an `appearance_forms` row.",
      "type": "object",
      "required": ["text", "cites"],
      "properties": {
        "text": { "$ref": "#/$defs/NonEmptyString" },
        "cites": { "$ref": "#/$defs/Cites" },
        "form": { "$ref": "#/$defs/KebabId" }
      },
      "unevaluatedProperties": false
    },
    "People": {
      "description": "A specific people. The umbrella terms Slavic, Slav, Slavs and Slavonic are rejected, case-insensitively.",
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s*[Ss][Ll][Aa][Vv]([Ss]|[Ii][Cc]|[Oo][Nn][Ii][Cc])?\\s*$)"
    },
    "Peoples": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/People" }
    },
    "NativeName": {
      "type": "object",
      "required": ["script", "text", "people", "cites"],
      "properties": {
        "script": {
          "description": "ISO 15924 script code, e.g. Cyrl, Latn, Glag.",
          "type": "string",
          "pattern": "^[A-Z][a-z]{3}$"
        },
        "text": { "$ref": "#/$defs/NonEmptyString" },
        "people": { "$ref": "#/$defs/People" },
        "cites": { "$ref": "#/$defs/Cites" }
      },
      "unevaluatedProperties": false
    },
    "Attestation": {
      "type": "object",
      "required": ["grade", "rationale", "assigned_by"],
      "properties": {
        "grade": { "$ref": "#/$defs/Grade" },
        "rationale": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/Clause" }
        },
        "assigned_by": { "const": "verify" }
      },
      "unevaluatedProperties": false
    },
    "Grade": {
      "enum": ["widely-attested", "regional", "literary", "disputed"]
    }
  }
}
