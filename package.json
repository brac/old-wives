{
  "name": "beasts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run site:test",
    "validate": "tsx src/validate/cli.ts",
    "corpus:fetch": "tsx src/corpus/fetch.ts",
    "corpus:build": "tsx src/corpus/build.ts",
    "corpus:verify": "tsx src/corpus/verify.ts",
    "cite": "tsx src/corpus/cite-cli.ts",
    "find": "tsx src/corpus/find-cli.ts",
    "stats": "tsx src/report/stats.ts",
    "plates": "tsx --env-file-if-exists=.env src/plates/generate.ts",
    "plates:finalise": "tsx src/plates/finalise.ts",
    "site:dev": "npm --prefix site run dev",
    "site:build": "npm --prefix site run build",
    "site:preview": "npm --prefix site run preview",
    "site:test": "npm --prefix site run build && npm --prefix site test",
    "site:contact-sheet": "npm --prefix site run contact-sheet"
  },
  "devDependencies": {
    "@fal-ai/client": "1.10.1",
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
